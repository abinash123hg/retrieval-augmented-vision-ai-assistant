# Secrets and local config — never bake these into the image.
.env
.env.*
!.env.example

# Local virtualenv and caches.
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Tests are not needed in the runtime image.
tests/
pytest.ini

# Runtime user data (uploads, processed content, indexes, reports) is mounted as
# a volume by docker-compose; do not copy the host's data into the image.
app/data/
